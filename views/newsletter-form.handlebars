<section class="newsletter-login" id="newsletter-login">
  <div class="login-card">
    <h3>Member Access</h3>
    <p>Sign in to manage your newsletter preferences and exclusive offers.</p>
    
    <form class="login-form" id="login-form">
      <div class="form-group">
        <label for="name">Your Name</label>
        <input type="text" id="name" name="name" placeholder="Frankelly Cordero" required>
      </div>
      
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="name@example.com" required>
      </div>
      
      <div class="form-group">
        <label for="password">Subscriber Key</label>
        <input type="password" id="password" name="password" placeholder="Enter your key" required>
      </div>
      
      <button type="submit" class="btn btn-primary btn-block">Access Newsletter</button>
      <a href="/#" class="forgot-link">Forgot your subscriber key?</a>
    </form>
  </div>
</section>

<script>
    const formElm = document.getElementById("login-form")

    formElm.addEventListener("submit", (evt) => {
      evt.preventDefault()
      const form = evt.target
      const body = JSON.stringify({
        password: form.elements.password.value,
        email: form.elements.email.value,
        name: form.elements.name.value
      })

      const headers = {"Content-Type": "application/json"}
      const container = document.getElementById("newsletter-login")

      fetch("/api/newsletter-signup", {method: "post", body, headers})
        .then(resp => {
            return resp.json()              
       
      }).then(json => {

            window.location.href = json.redirect

      })
        .catch(err => {
          container.innerHTML = '<b style="color:red;">Internal Server Error</b>'
      })
    })  
</script>
</div>

